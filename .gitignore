*.o

# Python
__pycache__/
*.pyc

# Scratch
/scratch/
*.img
software/cct/*.bin
software/cct/scm.nv
# Derived: tools/hpuxboot.py rebuilds the 5.01 kernel from the release
# tape, and the 520's clock battery is per-run state like the SCM's.
software/cct/*.nv

# Built fixed-disc images -- tools/mkharddisc.py + tools/installbasic.py
# reproduce them from the shipped discs in two commands
software/hd/*.img

# Disassembly listings -- tools/mkdisasm.sh reproduces all of it from the
# shipped 500ENV discs in one command, so only the README is tracked
disasm/*
!disasm/README.md

# MAME's hard disk device takes raw images through a .hd name; the run
# scripts make these links beside the images they point at.
*.hd

# The HP-UX machines tools/runhpux.sh boots: the pristine disc and battery
# assembled from software/cct, and the working copies runs use and keep
# (tools/lib/hpux.sh). All derived; --reset rebuilds them.
/var/

# Hewlett-Packard's software and manuals. The repository does not carry
# them: MEDIA.txt says where each one is and what it hashes to, and
# tools/fetch-media.sh fetches them to these paths (with --manuals for the
# documents, whose text it then extracts into docs/notes). The notes that
# stay tracked are the project's own OCR passes and page images.
software/cct/*.gz
docs/bitsavers/*
!docs/bitsavers/README.md
docs/hpjournal/*
!docs/hpjournal/README.md
docs/notes/*.txt
!docs/notes/*.tesseract.txt
!docs/notes/5955-3442_CS80_Instruction_Set_Programming_Manual.txt
!docs/notes/MODCAL_6.3_ERS.txt
# a download tools/fetch-media.sh has not finished
*.part
# The 520's software, from the HP Computer Museum: downloaded by hand and
# put in place by tools/fetch-media.sh --from (MEDIA.txt).
software/97089C.hpi
software/basic/*.TD0
software/demos/*.TD0
software/test/*.TD0
