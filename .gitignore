src/test/statetest
*.o

# Python
__pycache__/
*.pyc

# Scratch
/scratch/
*.img
software/cct/*.bin
software/cct/scm.nv
# Derived: tools/hpuxboot.py rebuilds the 5.01 kernel from the release
