*.o

# Python
__pycache__/
*.pyc

# Scratch
/scratch/
*.img
software/cct/*.bin
software/cct/scm.nv
# Derived: tools/hpuxboot.py rebuilds the 5.01 kernel from the release
# tape, and the 520's clock battery is per-run state like the SCM's.
software/cct/*.nv

# Built fixed-disc images -- tools/mkharddisc.py + tools/installbasic.py
# reproduce them from the shipped discs in two commands
software/hd/*.img

# Disassembly listings -- tools/mkdisasm.sh reproduces all of it from the
# shipped 500ENV discs in one command, so only the README is tracked
disasm/*
!disasm/README.md

# MAME's hard disk device takes raw images through a .hd name; the run
# scripts make these links beside the images they point at.
*.hd
